{
  "version": "0.6.1",
  "target": "macmini",
  "host": "CHANGE_ME",
  "port": 22,
  "user": "CHANGE_ME",
  "identity_file": "/etc/macctl/id_ed25519",
  "known_hosts_file": "/etc/macctl/known_hosts",
  "ssh_config_file": "/etc/macctl/ssh_config",
  "target_registry_file": "/etc/macctl/targets.json",
  "remote_linux_registry_file": "/etc/macctl/remote-linux-targets.json",
  "remote_linux_qualification_root": "/var/lib/macctl/remote-linux-qualifications",
  "control_dir": "/run/macctl",
  "control_persist_seconds": 600,
  "connect_timeout_seconds": 5,
  "command_timeout_seconds": 60,
  "max_output_bytes": 32768,
  "audit_path": "/var/log/macctl/audit.jsonl",
  "audit_max_bytes": 5242880,
  "audit_retention_files": 5,
  "audit_digest_seal": true,
  "transaction_dir": "/var/lib/macctl/transactions",
  "remote_shell": "/bin/zsh",
  "execution_backend": "REMOTE_SSH",
  "wake_mac": "",
  "wake_broadcast": "",
  "allow_macos_system_update": false,
  "allow_macos_major_upgrade": false,
  "artifact_root": "/var/lib/macctl/artifacts",
  "artifact_import_roots": [
    "/tmp"
  ],
  "artifact_default_ttl_seconds": 86400,
  "artifact_max_bytes": 536870912,
  "artifact_owner_principal": "local-owner",
  "attachment_delivery_root": "/var/lib/macctl/attachment-deliveries",
  "attachment_relay_root": "/var/lib/macctl/attachment-relays",
  "attachment_relay_github_repo": "",
  "attachment_relay_workflow": "attachment-relay.yml",
  "attachment_host_adapters": {},
  "artifact_lan_direct_enabled": false
}
